# --- Analytics / Tracking -----------------------------------------------
# Google Analytics 4 Measurement ID. Halladay's live GA4 property
# (G-CSMNSQBYHM) is already the default in components/AnalyticsScripts.tsx
# — this only needs setting to point at a DIFFERENT property (e.g. a
# staging/test GA4 property). Leave blank to use the live default.
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Halladay's GHL (GoHighLevel) sub-account External Tracking ID. The live
# tracking ID is already the default in components/AnalyticsScripts.tsx —
# this only needs setting to point at a DIFFERENT GHL sub-account/location
# (e.g. a staging GHL account). Leave blank to use the live default. GHL
# lead capture runs entirely through this script watching form submissions
# client-side — see the LEAD_WEBHOOK_URL note below; do not also point that
# at GHL, or every submission would create two GHL contacts.
NEXT_PUBLIC_GHL_TRACKING_ID=

# Google Ads Conversion ID + per-action labels (set once Google Ads is live)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL=

# --- Lead delivery ---------------------------------------------------------
# Generic outbound webhook for lead submissions (Zapier / Make / a future
# CRM, etc). Leave blank in local/dev — submissions are logged server-side
# only. Do NOT point this at GHL — GHL lead capture is handled entirely by
# the External Tracking script (NEXT_PUBLIC_GHL_TRACKING_ID above), which
# watches the site's real form submissions client-side. Setting this to a
# GHL webhook as well would create two GHL contacts per submission.
LEAD_WEBHOOK_URL=

# Optional shared secret sent as X-Lead-Webhook-Secret header
LEAD_WEBHOOK_SECRET=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google review sync (optional, not used by the running site) -----------
# Only used by `npm run sync-reviews` (scripts/sync-google-reviews.mjs), a
# manual/scheduled script — not called by the live site, so it adds no
# per-visitor latency or cost. See README.md for setup + pricing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
