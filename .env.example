# --- Analytics / Tracking -----------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads Conversion ID + per-action labels (set once Google Ads is live)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL=

# --- Lead delivery ---------------------------------------------------------
# Generic outbound webhook for lead submissions (Zapier / Make / GHL / CRM).
# Leave blank in local/dev — submissions are logged server-side only.
LEAD_WEBHOOK_URL=

# Optional shared secret sent as X-Lead-Webhook-Secret header
LEAD_WEBHOOK_SECRET=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google review sync (optional, not used by the running site) -----------
# Only used by `npm run sync-reviews` (scripts/sync-google-reviews.mjs), a
# manual/scheduled script — not called by the live site, so it adds no
# per-visitor latency or cost. See README.md for setup + pricing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
